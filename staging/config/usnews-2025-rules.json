{
  "metadata": {
    "source": "usnews",
    "year": 2025,
    "format": "csv",
    "encoding": "utf-8",
    "description": "U.S. News & World Report Best Global Universities 2025 - Extracted from standardize-usnews.js",
    "version": "1.0.0",
    "created_date": "2025-06-20",
    "author": "V2 Pipeline Migration",
    "notes": "Battle-tested transformations extracted from existing US News processing script"
  },
  "fileProcessing": {
    "skipLines": 0,
    "csvOptions": {
      "encoding": "utf-8",
      "mapValues": "trim"
    },
    "headerProcessing": {
      "trimWhitespace": true,
      "removeEmptyColumns": true
    },
    "errorHandling": {
      "skipMalformedRows": true,
      "maximumErrors": 10,
      "stopOnCriticalError": true
    }
  },
  "columnMappings": {
    "rank": {
      "primaryHeaders": ["Rank"],
      "alternativeHeaders": ["rank", "World Rank", "Ranking"],
      "columnIndex": 0,
      "processing": "handleRangeRanks",
      "required": true,
      "validation": {
        "allowRanges": true,
        "minimumRank": 1,
        "maximumRank": 2000
      }
    },
    "name": {
      "primaryHeaders": ["University"],
      "alternativeHeaders": ["name", "Institution", "University Name"],
      "columnIndex": 1,
      "processing": "normalizeUniversityName",
      "required": true,
      "validation": {
        "minimumLength": 2,
        "allowEmpty": false
      }
    },
    "country": {
      "primaryHeaders": ["Country"],
      "alternativeHeaders": ["country", "Territory", "Location"],
      "columnIndex": 2,
      "processing": "standardizeCountry",
      "required": true,
      "validation": {
        "allowEmpty": false,
        "standardizeFirst": true
      }
    }
  },
  "transformationRules": {
    "universityNames": {
      "basic": [
        "stringValidation",
        "caseNormalization",
        "diacriticsRemoval",
        "whitespaceNormalization"
      ],
      "enhanced": [
        {
          "name": "parentheticalRemoval",
          "type": "regex_replace",
          "pattern": "\\s*\\([^)]*\\)\\s*",
          "replacement": "",
          "flags": "g",
          "riskLevel": "LOW",
          "frequency": 35,
          "description": "Remove parenthetical expressions like (MIT), (UCL)"
        },
        {
          "name": "locationSuffixRemoval",
          "type": "regex_replace",
          "pattern": "\\s*-\\s*(australia|uk|newcastle-upon-tyne)$",
          "replacement": "",
          "flags": "i",
          "riskLevel": "LOW",
          "frequency": 12,
          "description": "Remove location suffixes like ' - Australia', ' - UK'"
        },
        {
          "name": "institutionTypeRemoval",
          "type": "regex_replace",
          "pattern": "\\s+(university|college|institute|of technology)$",
          "replacement": "",
          "flags": "i",
          "riskLevel": "MEDIUM",
          "frequency": 0,
          "description": "Remove generic institution type suffixes (disabled by default)"
        },
        {
          "name": "thePrefixGeneral",
          "type": "regex_replace",
          "pattern": "^The\\s+",
          "replacement": "",
          "flags": "",
          "riskLevel": "VERY_LOW",
          "frequency": 3,
          "description": "Remove 'The' prefix from university names"
        }
      ],
      "sourceSpecific": {
        "exactMappings": {
          "Massachusetts Institute of Technology (MIT)": "Massachusetts Institute of Technology",
          "University College London": "UCL",
          "University of California Berkeley": "University of California, Berkeley",
          "University of California Los Angeles": "University of California, Los Angeles",
          "University of California San Francisco": "University of California, San Francisco",
          "University of California San Diego": "University of California, San Diego",
          "University of Washington Seattle": "University of Washington",
          "University of Michigan": "University of Michigan",
          "California Institute of Technology": "California Institute of Technology"
        },
        "thePrefixWhitelist": [
          "The University of Sydney",
          "The University of Melbourne",
          "The University of Hong Kong",
          "The Chinese University of Hong Kong",
          "The Australian National University"
        ]
      }
    },
    "countries": {
      "mappings": {
        "United States": "United States",
        "United Kingdom": "United Kingdom"
      }
    },
    "ranks": {
      "handleRanges": true,
      "rangeStrategy": "lowerBound",
      "maximumRank": 2000,
      "patterns": [
        {
          "name": "tiedRanks",
          "type": "regex_replace",
          "pattern": "^(\\d+)$",
          "replacement": "$1",
          "description": "Handle single rank numbers including tied ranks"
        },
        {
          "name": "hyphenRanges",
          "type": "regex_replace",
          "pattern": "^(\\d+)-(\\d+)$",
          "replacement": "$1",
          "description": "Convert range ranks like '201-250' to lower bound"
        }
      ]
    }
  },
  "validation": {
    "names": {
      "minimumLength": 2,
      "maximumLength": 200,
      "skipHeaders": ["Rank", "University", "Country"],
      "allowEmpty": false,
      "patterns": {
        "invalid": ["^\\s*$", "^\\d+$"],
        "suspicious": ["test", "example", "unknown"]
      }
    },
    "ranks": {
      "minimumRank": 1,
      "maximumRank": 2000,
      "allowRanges": true,
      "allowEmpty": false,
      "rangeFormats": ["\\d+-\\d+", "\\d+"]
    },
    "countries": {
      "allowEmpty": false,
      "standardizeFirst": true,
      "minimumLength": 2,
      "maximumLength": 50
    }
  },
  "outputFormat": {
    "columns": ["rank", "name", "country"],
    "encoding": "utf-8",
    "includeHeaders": true,
    "csvFormat": {
      "delimiter": ",",
      "quoteChar": "\"",
      "includeComments": true,
      "commentLines": [
        "# University Ranking Results - US News & World Report",
        "# Ranking: US News Global Universities",
        "# Year: 2025",
        "#"
      ]
    }
  },
  "qualityAssurance": {
    "expectedMinimumRows": 1000,
    "expectedMaximumRows": 2500,
    "duplicateHandling": "warn",
    "missingDataHandling": "skip",
    "outlierDetection": {
      "enabled": true,
      "suspiciousPatterns": ["test", "example", "unknown university"]
    }
  }
}